# ══════════════════════════════════════════════════════
#  DevOps Agent — Environment Variables
#  1. Copy:  cp .env.example .env
#  2. Fill in your values
#  3. NEVER commit .env  (already in .gitignore)
# ══════════════════════════════════════════════════════

# Port the app is reachable on (default 80)
FRONTEND_PORT=80

# Internal backend port — NOT exposed to internet
BACKEND_PORT=8000

# Python flags
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
